# Model adapter: use "mock" for the built-in deterministic demo or "live" for an API gateway.
AURORA_MODE=mock
# Credentials are read from the environment and are never committed to the repository.
OPENAI_API_KEY=
# OpenAI-compatible endpoint used when AURORA_MODE=live.
OPENAI_BASE_URL=https://api.openai.com/v1
# Model identifier passed to the configured gateway.
AURORA_MODEL=gpt-4o-mini
# Local HTTP port for the Evidence Workbench.
AURORA_PORT=8765

